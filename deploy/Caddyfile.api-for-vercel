# Website on Vercel (wow.osrs.dk), backend at home. Caddy publishes ONLY the
# read-only API on its own hostname; the page calls it directly (frontend/config.js).
# Replace the backend's LAN IP. Backend env: FT_CORS_ORIGINS=https://wow.osrs.dk
wow-api.osrs.dk {
	@read {
		method GET HEAD
		path /api/state /api/history /api/stream
	}
	handle @read {
		reverse_proxy 192.168.1.221:8787 {
			# Stream /api/stream (Server-Sent Events) without buffering.
			flush_interval -1
		}
	}
	# Everything else, including /api/ingest, stays off the internet.
	respond 404
}
