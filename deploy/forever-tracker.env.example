# Shared secret for the companion app. Generate with: openssl rand -hex 32
FT_TOKEN=
FT_DB=/var/lib/forever-tracker/tracker.sqlite3
FT_HOST=0.0.0.0
FT_PORT=8787
FT_STATIC=/opt/forever-tracker/frontend
# Source networks allowed to POST /api/ingest (requests via a proxy are always refused)
FT_INGEST_NETS=192.168.1.0/24,127.0.0.0/8
# Seconds out of combat before health and mana are shown as full again
FT_FULL_AFTER=30
# Sites on other hosts that may read the API (the Vercel website). Comma-separated, "*" = any.
FT_CORS_ORIGINS=https://wow.osrs.dk
